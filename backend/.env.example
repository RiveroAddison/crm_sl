DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-secret"
# IMPORTANTE: usar un secreto distinto y robusto para los refresh tokens.
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
# TTLs de tokens (formato: 15m, 1h, 7d, etc.).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
PORT=3000
NODE_ENV=development
# Orígenes CORS permitidos (separados por comas). Solo estas URLs podrán
# consumir la API desde el navegador. Usa "*" solo en desarrollo local.
# Ejemplo: "http://localhost:5173,http://localhost:4173,https://crm.tu-dominio.com"
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"
# Rate limit GLOBAL (anti-abuso para toda la API).
# Ventana en ms y maximo de peticiones por IP dentro de esa ventana.
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
# Rate limit ESTRICTO para endpoints sensibles (login, context, etc.).
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
# Consultas SELECT opcionales para el adaptador Profit SQL Server.
PROFIT_CUSTOMERS_QUERY="SELECT TOP 1000 * FROM clientes"
PROFIT_SALES_QUERY="SELECT TOP 1000 * FROM facturas"
